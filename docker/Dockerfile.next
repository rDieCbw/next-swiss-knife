FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc nx.json tsconfig.base.json eslint.config.mjs ./
COPY apps ./apps
COPY libs ./libs
RUN pnpm install --frozen-lockfile
ARG APP
RUN pnpm --filter @swiss/${APP} build

FROM node:22-alpine AS runner
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
WORKDIR /app
COPY --from=build /app /app
ARG APP
ARG PORT=3000
ENV PORT=${PORT}
EXPOSE ${PORT}
CMD pnpm --filter @swiss/${APP} start
